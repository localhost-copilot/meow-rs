# GNU host build scripts can load libclang; the resulting clients are static musl.
FROM rust:1.91-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang libclang-dev llvm cmake pkg-config perl python3-venv openssl curl \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/zig && /opt/zig/bin/pip install --no-cache-dir ziglang==0.13.0 \
    && ln -s "$(/opt/zig/bin/python -c 'import pathlib, ziglang; print(pathlib.Path(ziglang.__file__).parent / "zig")')" /usr/local/bin/zig
RUN cargo install --locked cargo-zigbuild --version 0.20.1
ARG RUST_TARGET=aarch64-unknown-linux-musl
RUN rustup target add "$RUST_TARGET"
WORKDIR /work
COPY . .
RUN cargo zigbuild --locked --target "$RUST_TARGET" -p meow-openconnect --features dtls --tests \
    && for test in target/$RUST_TARGET/debug/deps/meow_openconnect-* target/$RUST_TARGET/debug/deps/dtls_backend-*; do \
       if [ -x "$test" ] && [ -f "$test" ]; then "$test" --include-ignored || exit 1; fi; done
RUN cargo zigbuild --locked --target "$RUST_TARGET" -p meow-netstack --test sockets \
    && for test in target/$RUST_TARGET/debug/deps/sockets-*; do \
       if [ -x "$test" ] && [ -f "$test" ]; then "$test" || exit 1; fi; done
RUN cargo zigbuild --locked --target "$RUST_TARGET" -p meow-app --no-default-features \
    --features openconnect-dtls,listener-mixed --test openconnect_e2e --test openconnect_dtls_reference \
    && for test in target/$RUST_TARGET/debug/deps/openconnect_e2e-*; do \
       if [ -x "$test" ] && [ -f "$test" ]; then "$test" || exit 1; fi; done
RUN cargo zigbuild --locked --release --target "$RUST_TARGET" -p meow-app --no-default-features \
    --features minimal,openconnect-dtls \
    && cp "target/$RUST_TARGET/release/meow" /usr/local/bin/meow
# A static binary must not need an ELF interpreter or any runtime shared library.
RUN readelf -l /usr/local/bin/meow > /tmp/program-headers && ! grep -q INTERP /tmp/program-headers \
    && readelf -d /usr/local/bin/meow > /tmp/dynamic && ! grep -q NEEDED /tmp/dynamic
CMD ["/usr/local/bin/meow", "-f", "/fixture/client.yaml"]
